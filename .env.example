# AquaVision AI Water Quality Analysis Platform — Environment Template
# Duplicate this file to .env and insert your Gemini API Key.
# Get an API key at: https://aistudio.google.com/app/apikey

GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Large Language Model for LangGraph AI Copilot & Report Reasoning
GEMINI_MODEL=gemini-3.1-flash-lite

# Failover model sequence for transient rate limits or quota pauses
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# ChromaDB Vector Store Embedding Model for Standards and Methodology RAG
EMBEDDING_MODEL=models/gemini-embedding-001

# Server port configuration
PORT=8000

